[
  {
    "source": "C:\\Users\\ExampleUser\\Documents",
    "target_dir": "Documents",
    "excludes": [
      "*.tmp",
      "Cache/*",
      "node_modules",
      "!.git"
    ],
    "force_hash": false,
    "verify_copy": true,
    "max_workers": 4,
    "retention_days": 90,
    "case_sensitive_excludes": false
  }
]